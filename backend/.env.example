# App
APP_NAME="HostelDesk — AI Hostel Complaint Management"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="change-me-use-a-long-random-string-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origin (CORS / cookie domain)
FRONTEND_ORIGIN="http://localhost:5173"

# Database — SQLite by default; point at Postgres for production
DATABASE_URL="sqlite:///./data/hosteldesk.db"
# DATABASE_URL="postgresql+psycopg2://hosteldesk:secret@db:5432/hosteldesk"

# Uploaded complaint photos
UPLOAD_DIR="./uploads"

# --- NVIDIA AI (backend-only secret — never expose to the frontend) ---
# Get a free key at https://build.nvidia.com. Empty = offline fallback mode.
NVIDIA_API_KEY=
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# Seed credentials (used by seed.py)
SEED_ADMIN_EMAIL="admin@hosteldesk.io"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_WARDEN_EMAIL="warden@hosteldesk.io"
SEED_WARDEN_PASSWORD="Warden@12345"
SEED_STUDENT_EMAIL="student@hosteldesk.io"
SEED_STUDENT_PASSWORD="Student@12345"
